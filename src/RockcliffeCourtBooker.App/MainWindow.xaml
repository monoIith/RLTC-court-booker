<Window x:Class="RockcliffeCourtBooker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rockcliffe Court Booker"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Rockcliffe Court Booker">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="258" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrandDarkBrush}">
            <Grid Margin="22,26,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="R" Foreground="White" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ROCKCLIFFE" Foreground="White" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="Court Booker" Foreground="#A9C2B8" FontSize="12" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Margin="0,28,0,7" Text="BOOKING CONTROL" Foreground="#75978A"
                           FontSize="10" FontWeight="Bold" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigation}"
                         Style="{StaticResource NavigationList}"
                         ItemContainerStyle="{StaticResource NavigationItem}"
                         AutomationProperties.Name="Application sections">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.72" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Padding="13" CornerRadius="9" Background="#183D30">
                    <StackPanel>
                        <TextBlock Text="{Binding ApplicationState.MemberName}" Foreground="White"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AdapterStatus}" Margin="0,4,0,0" Foreground="#F4C89E"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="34,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{Binding CurrentPageDescription}" Margin="0,4,0,0"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="Current application page" />
        </Grid>
    </Grid>
</Window>
