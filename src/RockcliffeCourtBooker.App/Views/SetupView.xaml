<UserControl x:Class="RockcliffeCourtBooker.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Setup">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,30,34,40" MaxWidth="1060">
            <Border Padding="16" CornerRadius="10" Background="{StaticResource ToneWarningBackgroundBrush}"
                    BorderBrush="#E9C56A" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                               Foreground="{StaticResource ToneWarningBrush}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Protect your Matchpoint password" FontWeight="SemiBold"
                                   Foreground="{StaticResource ToneWarningBrush}" />
                        <TextBlock Text="{Binding SecurityWarning}" Margin="0,4,0,0"
                                   Foreground="{StaticResource ToneWarningBrush}" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,18,0,0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Account configuration" Style="{StaticResource CardTitleText}" />
                    <TextBlock Margin="0,5,0,20" Style="{StaticResource MutedText}"
                               Text="Choose the external JSON file. It is read again before every attempt, so updates take effect automatically." />

                    <TextBlock Text="Configuration file" Style="{StaticResource FieldLabelText}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ConfigurationPath, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Configuration JSON file path" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Content="_Browse…" Command="{Binding BrowseCommand}"
                                AutomationProperties.Name="Browse for configuration JSON" />
                        <Button Grid.Column="2" Margin="8,0,0,0" Content="_Validate" Command="{Binding ValidateCommand}"
                                Style="{StaticResource PrimaryButton}"
                                AutomationProperties.Name="Validate configuration" />
                    </Grid>

                    <Border Margin="0,16,0,0" Padding="12" CornerRadius="8"
                            Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{Binding StatusTone, Converter={StaticResource StatusToneToBackgroundConverter}}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusTone, Converter={StaticResource StatusToneToBrushConverter}}" />
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ACCOUNT HOLDER" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding AccountHolder}" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="LOGIN" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding UsernameDisplay}" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STATUS" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Needs validation" />
                                        <Setter Property="Foreground" Value="{StaticResource ToneWarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigurationValid}" Value="True">
                                                <Setter Property="Text" Value="Ready" />
                                                <Setter Property="Foreground" Value="{StaticResource ToneSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Selectable players" Style="{StaticResource CardTitleText}" />
                        <TextBlock Margin="0,5,0,16" Style="{StaticResource MutedText}"
                                   Text="These names must exactly match the people shown on Matchpoint's Modify screen." />
                        <TextBlock Text="No players loaded. Validate a configuration file to see its player directory."
                                   Style="{StaticResource MutedText}"
                                   Visibility="{Binding HasPlayers, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Players}"
                                      Visibility="{Binding HasPlayers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="11,7" CornerRadius="16"
                                            Background="{StaticResource SurfaceSubtleBrush}">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Connection diagnostics" Style="{StaticResource CardTitleText}" />
                        <TextBlock Margin="0,5,0,16" Style="{StaticResource MutedText}"
                                   Text="Use a visible browser during setup so you can safely inspect login or page changes." />
                        <CheckBox Content="Show browser while testing" IsChecked="{Binding UseVisibleBrowser}"
                                  AutomationProperties.Name="Show diagnostic browser" />
                        <Button Margin="0,14,0,0" Content="Test _login" Command="{Binding TestLoginCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center" />
                        <Button Margin="0,8,0,0" Content="Verify _players" Command="{Binding VerifyPlayersCommand}"
                                HorizontalContentAlignment="Center" />
                        <Separator Margin="0,16,0,12" />
                        <TextBlock Text="Unattended submission" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,10" Style="{StaticResource MutedText}"
                                   Text="Requires Eastern time, a synchronized Windows clock, and a signed-in user." TextWrapping="Wrap" />
                        <Button Content="{Binding UnattendedToggleLabel}"
                                Command="{Binding ToggleUnattendedSubmissionCommand}"
                                HorizontalContentAlignment="Center" />
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource MutedText}"
                                   Text="Diagnostics never submit a court booking." />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
