<UserControl x:Class="RockcliffeCourtBooker.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="History and diagnostics">
    <Grid Margin="34,30,34,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="2*" MinHeight="190" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Outcome" Margin="0,0,10,0" FontWeight="SemiBold" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                      AutomationProperties.Name="Filter booking outcomes" />
            <Border Grid.Column="2" Margin="16,0" Padding="12,8" CornerRadius="8"
                    Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{Binding StatusTone, Converter={StaticResource StatusToneToBackgroundConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusTone, Converter={StaticResource StatusToneToBrushConverter}}" />
            </Border>
            <Button Grid.Column="3" Content="_Refresh" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="4" Margin="8,0,0,0" Content="Clear non-protected _history" Command="{Binding ClearCommand}"
                    Style="{StaticResource DangerButton}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Attempts}"
                          SelectedItem="{Binding SelectedAttempt}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          AutomationProperties.Name="Booking attempt history">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STARTED" Binding="{Binding Started}" Width="1.25*" />
                        <DataGridTextColumn Header="RULE" Binding="{Binding Model.RuleName}" Width="1.2*" />
                        <DataGridTextColumn Header="PLAY DATE" Binding="{Binding TargetDate}" Width="1.15*" />
                        <DataGridTextColumn Header="OUTCOME" Binding="{Binding Outcome}" Width="1*" />
                        <DataGridTextColumn Header="COURT / TIME" Binding="{Binding CourtAndTime}" Width="1.1*" />
                        <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="0.75*" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasAttempts, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Margin="0,12,0,0" Text="No attempts match this filter" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0" Text="Booking results and safe failure details will appear here."
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Attempt details" Style="{StaticResource CardTitleText}" />
                    <TextBlock Margin="0,8,0,0" Text="Select an attempt above to inspect its sanitized result."
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,10,0,0" Text="{Binding SelectedAttempt.Model.RuleName}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding SelectedAttempt.Message}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource MutedText}">
                            <Run Text="Target: " /><Run Text="{Binding SelectedAttempt.TargetDate}" />
                            <Run Text="   ·   " /><Run Text="{Binding SelectedAttempt.CourtAndTime}" />
                            <Run Text="   ·   " /><Run Text="{Binding SelectedAttempt.Duration}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Margin="20,0,0,0" Padding="16" CornerRadius="9"
                        Background="{StaticResource SurfaceSubtleBrush}">
                    <StackPanel>
                        <TextBlock Text="Local diagnostics" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,13" Style="{StaticResource MutedText}"
                                   Text="Failure-only artifacts may contain player or session information. Keep them private." />
                        <Button Content="Open _screenshot" Command="{Binding OpenScreenshotCommand}"
                                HorizontalContentAlignment="Center" />
                        <Button Margin="0,8,0,0" Content="Open Playwright _trace" Command="{Binding OpenTraceCommand}"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
