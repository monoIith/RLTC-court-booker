<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Id="RockcliffeCourtBooker.Desktop"
           Name="Rockcliffe Court Booker"
           Manufacturer="Rockcliffe Court Booker"
           Version="$(var.ProductVersion)"
           Scope="perUser"
           InstallerVersion="500">
    <SummaryInformation Description="Authorized Rockcliffe clay-court booking assistant." />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Rockcliffe Court Booker is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="PerUserProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="Rockcliffe Court Booker" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Rockcliffe Court Booker">
        <Component Id="ApplicationShortcutComponent">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="Rockcliffe Court Booker"
                    Description="Schedule authorized clay-court bookings"
                    Target="[INSTALLFOLDER]RockcliffeCourtBooker.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\RockcliffeCourtBooker"
                         Name="Installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Component Id="CleanupScriptComponent" Directory="INSTALLFOLDER">
      <File Id="CleanupUserDataScript"
            Source="$(sys.SOURCEFILEDIR)CleanupUserData.cmd"
            KeyPath="yes" />
    </Component>

    <Component Id="NotificationDependencyScriptComponent" Directory="INSTALLFOLDER">
      <File Id="InstallNotificationDependenciesScript"
            Source="$(sys.SOURCEFILEDIR)InstallNotificationDependencies.ps1"
            KeyPath="yes" />
    </Component>

    <SetProperty Id="InstallNotificationDependencies"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#InstallNotificationDependenciesScript]&quot; -FrameworkPackagePath &quot;[INSTALLFOLDER]prerequisites\Microsoft.WindowsAppRuntime.2.msix&quot; -SingletonPackagePath &quot;[INSTALLFOLDER]prerequisites\Microsoft.WindowsAppRuntime.Singleton.2.msix&quot;"
                 Before="InstallNotificationDependencies"
                 Sequence="execute"
                 Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    <CustomAction Id="InstallNotificationDependencies"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />

    <SetProperty Id="UnregisterRockcliffeNotifications"
                 Value="&quot;[INSTALLFOLDER]worker\RockcliffeCourtBooker.Worker.exe&quot; --unregister-notifications"
                 Before="UnregisterRockcliffeNotifications"
                 Sequence="execute"
                 Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="UnregisterRockcliffeNotifications"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <SetProperty Id="DeleteRockcliffeScheduledTask"
                 Value="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;RockcliffeCourtBooker&quot; /F"
                 Before="DeleteRockcliffeScheduledTask"
                 Sequence="execute"
                 Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="DeleteRockcliffeScheduledTask"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <SetProperty Id="DeleteRockcliffeDataFiles"
                 Value="&quot;[System64Folder]cmd.exe&quot; /D /C &quot;&quot;[#CleanupUserDataScript]&quot;&quot;"
                 Before="DeleteRockcliffeDataFiles"
                 Sequence="execute"
                 Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="DeleteRockcliffeDataFiles"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallNotificationDependencies"
              After="InstallFiles"
              Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="UnregisterRockcliffeNotifications"
              Before="DeleteRockcliffeScheduledTask"
              Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="DeleteRockcliffeScheduledTask"
              Before="DeleteRockcliffeDataFiles"
              Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="DeleteRockcliffeDataFiles"
              Before="RemoveFiles"
              Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Files Include="!(bindpath.Publish)\**" Directory="INSTALLFOLDER">
      <Exclude Files="!(bindpath.Publish)\**\*.pdb" />
      <Exclude Files="!(bindpath.Publish)\**\*.xml" />
    </Files>
  </Package>
</Wix>
